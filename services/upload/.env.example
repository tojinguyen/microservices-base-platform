# App
APP_MODE=api
TIME_GRACE=15
PORT=8083

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USER=user_admin
DATABASE_PASSWORD=password123
DATABASE_DBNAME=upload_db
DATABASE_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Broker (RabbitMQ)
BROKER_HOST=localhost
BROKER_PORT=5672
BROKER_USER=guest
BROKER_PASSWORD=guest

# Storage (MinIO / S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=videos
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_PATH_STYLE=true
STORAGE_PUBLIC_URL=http://localhost:9000/videos

# Upload limits
UPLOAD_MAX_SIZE_BYTES=5368709120
UPLOAD_PRESIGN_TTL_SECONDS=900
UPLOAD_ALLOWED_MIME_TYPES=video/mp4,video/quicktime,video/webm

# Janitor worker
JANITOR_INTERVAL_SECONDS=300
JANITOR_BATCH_SIZE=100

# Rate limit
RATE_LIMIT_LIMIT=60
RATE_LIMIT_WINDOW_SECS=60

# OpenTelemetry
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
