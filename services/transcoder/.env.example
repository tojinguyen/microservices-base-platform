# App
APP_MODE=worker
TIME_GRACE=30

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5435
DATABASE_USER=user_admin
DATABASE_PASSWORD=password123
DATABASE_DBNAME=transcoder_db
DATABASE_SSLMODE=disable

# Broker (RabbitMQ)
BROKER_HOST=localhost
BROKER_PORT=5672
BROKER_USER=guest
BROKER_PASSWORD=guest

# Storage (MinIO / S3) — shared bucket with upload-service
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=videos
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_PATH_STYLE=true

# Transcoder
TRANSCODER_CONCURRENCY=2
TRANSCODER_MAX_RETRIES=3
TRANSCODER_TMP_DIR=/tmp/transcoder
TRANSCODER_HLS_PREFIX=hls
TRANSCODER_SEGMENT_DURATION=6
TRANSCODER_UPLOAD_CONCURRENCY=10
TRANSCODER_QUEUE_NAME=transcoder.video.uploaded
TRANSCODER_SOURCE_EXCHANGE=video.events
TRANSCODER_SOURCE_ROUTING_KEY=video.uploaded
TRANSCODER_FFMPEG_BINARY=ffmpeg

# OpenTelemetry
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
